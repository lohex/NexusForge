# Qwen3.5-4B Long Context configuration

# Native context of Qwen3.5
YARN_ORIGINAL_CONTEXT=262144

# Target context
CONTEXT_SIZE=524288

# 524288 / 262144 = 2
YARN_FACTOR=2.0

# KV cache quantization
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0

# Only one long-context session
PARALLEL=1

HOST=127.0.0.1
PORT=8081
