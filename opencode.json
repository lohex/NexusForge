{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-main": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NexusForge Main",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.5-9b-orchestrator": {
          "name": "Qwen3.5 9B Orchestrator",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    },

    "llama-granite": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NexusForge Granite",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "granite-4.2-3b-multi": {
          "name": "Granite 4.2 3B Multi",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "granite-4.2-8b-orchestrator": {
          "name": "Granite 4.2 8B Orchestrator",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    },

    "llama-long": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NexusForge Long Context",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.5-4b-long-context": {
          "name": "Qwen3.5 4B Long Context",
          "limit": {
            "context": 524288,
            "output": 8192
          }
        }
      }
    },

    "llama-ornith": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NexusForge Ornith",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "ornith-1.5-9b-orchestrator": {
          "name": "Ornith 1.5 9B Orchestrator",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },

  "model": "llama-main/qwen3.5-9b-orchestrator",
  "default_agent": "qwen-orchestrator",
  "permission": {
    "websearch": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "qwen-orchestrator": {
      "description": "Default orchestrator for planning, delegation, integration, and review",
      "mode": "primary",
      "model": "llama-main/qwen3.5-9b-orchestrator",
      "permission": {
        "task": {
          "*": "deny",
          "granite-multi": "allow",
          "long-context": "allow"
        }
      }
    },
    "ornith-orchestrator": {
      "description": "Long-context orchestrator for repository-wide planning and difficult reasoning",
      "mode": "primary",
      "model": "llama-ornith/ornith-1.5-9b-orchestrator",
      "permission": {
        "task": {
          "*": "deny",
          "granite-multi": "allow",
          "long-context": "allow"
        }
      }
    },
    "granite-orchestrator": {
      "description": "Optional Granite 4.2 8B orchestrator for planning, integration, and review",
      "mode": "primary",
      "model": "llama-granite/granite-4.2-8b-orchestrator",
      "permission": {
        "task": {
          "*": "deny",
          "granite-multi": "allow",
          "long-context": "allow"
        }
      }
    },
    "granite-multi": {
      "description": "Implements one small, bounded task from a referenced Task Markdown file",
      "mode": "subagent",
      "model": "llama-granite/granite-4.2-3b-multi",
      "prompt": "Work only on the assigned Task Markdown. Read it before acting, respect its owned paths and constraints, run its validation, and report changed files, checks, and blockers. Do not delegate further.",
      "permission": {
        "task": "deny"
      }
    },
    "long-context": {
      "description": "Reads one oversized source and returns focused findings with evidence locations",
      "mode": "subagent",
      "model": "llama-long/qwen3.5-4b-long-context",
      "prompt": "Read only the source identified in the assigned prompt and extract the requested information with useful headings, page numbers, or line numbers. Report findings, uncertainties, missing information, and blockers. Do not edit files, perform final synthesis, delegate, or call switch_model.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "switch_model": "deny"
      }
    }
  }
}
